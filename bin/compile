#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

BIN_PATH="$BUILD_DIR/bin"
LIB_PATH="$BUILD_DIR/vendor/wkhtmltox/lib"
TMP_PATH="$BUILD_DIR/tmp"
mkdir -p $CACHE_DIR $BIN_PATH $LIB_PATH $TMP_PATH

if [[ -f "$ENV_DIR/WKHTMLTOPDF_VERSION" ]]; then
  WKHTMLTOPDF_VERSION=$(cat "$ENV_DIR/WKHTMLTOPDF_VERSION")
else
  WKHTMLTOPDF_VERSION="0.12.4"
fi

# wkhtmltopdf published Linux builds in two places with different asset layouts:
# - wkhtmltopdf/wkhtmltopdf releases (0.12.4 and earlier): self-contained
#   linux-generic tarball. 0.12.4 is the LAST release with this asset.
# - wkhtmltopdf/packaging releases (0.12.6.x, tags like 0.12.6.1-3): per-distro
#   debs. jammy is the newest published Linux build; it is the same build the
#   wkhtmltopdf-binary gem ships for Ubuntu 22.04 and 24.04.
# Packaging tags always carry a hyphenated revision, so dispatch on that.
if [[ "$WKHTMLTOPDF_VERSION" == *-* ]]; then
  SOURCE="packaging"
  WKHTMLTOPDF_URL="https://github.com/wkhtmltopdf/packaging/releases/download/${WKHTMLTOPDF_VERSION}/wkhtmltox_${WKHTMLTOPDF_VERSION}.jammy_amd64.deb"
  WKHTMLTOPDF_ARCHIVE="$CACHE_DIR/wkhtmltox-${WKHTMLTOPDF_VERSION}.deb"
else
  SOURCE="generic"
  WKHTMLTOPDF_URL="https://github.com/wkhtmltopdf/wkhtmltopdf/releases/download/${WKHTMLTOPDF_VERSION}/wkhtmltox-${WKHTMLTOPDF_VERSION}_linux-generic-amd64.tar.xz"
  WKHTMLTOPDF_ARCHIVE="$CACHE_DIR/wkhtmltox-${WKHTMLTOPDF_VERSION}.tar.xz"
fi

WKHTMLTOPDF_PATH="$TMP_PATH/wkhtmltox"

BIN_DIR=$(cd $(dirname $0); pwd)
FONTS_DIR=$(cd "$BIN_DIR/../fonts"; pwd)

# The cache key includes the version so a WKHTMLTOPDF_VERSION change takes
# effect on the next deploy. Drop the pre-versioning cache file.
rm -f "$CACHE_DIR/wkhtmltox.tar.xz"

if [ -f "$WKHTMLTOPDF_ARCHIVE" ]; then
  echo "-----> Using wkhtmltopdf ${WKHTMLTOPDF_VERSION} from cache"
else
  echo "-----> Downloading wkhtmltopdf ${WKHTMLTOPDF_VERSION} (${SOURCE} build)"
  # -f: a 404 must fail the build here, not surface later as a corrupt archive
  curl -fL --retry 3 "$WKHTMLTOPDF_URL" -o "$WKHTMLTOPDF_ARCHIVE"
fi

echo "-----> Unpacking"
mkdir -p "$WKHTMLTOPDF_PATH"
if [ "$SOURCE" = "packaging" ]; then
  dpkg-deb -x "$WKHTMLTOPDF_ARCHIVE" "$WKHTMLTOPDF_PATH"
  WKHTMLTOPDF_BINARIES="$WKHTMLTOPDF_PATH/usr/local/bin"
  WKHTMLTOPDF_LIBS="$WKHTMLTOPDF_PATH/usr/local/lib"
else
  tar -xf "$WKHTMLTOPDF_ARCHIVE" -C $TMP_PATH
  WKHTMLTOPDF_BINARIES="$WKHTMLTOPDF_PATH/bin"
  WKHTMLTOPDF_LIBS="$WKHTMLTOPDF_PATH/lib"
fi

echo "-----> Setting permissions"
chmod +x $WKHTMLTOPDF_BINARIES/*

echo "-----> Moving binaries to the right place"
mv $WKHTMLTOPDF_BINARIES/* $BIN_PATH/

echo "-----> Moving libs to the right place"
mv $WKHTMLTOPDF_LIBS/* $LIB_PATH/

echo "-----> Cleaning up"
rm -rf $WKHTMLTOPDF_PATH

echo "-----> Installing fonts"
mkdir -p $1/.fonts
ls $FONTS_DIR
cp $FONTS_DIR/* $1/.fonts/
fc-cache -f $1/.fonts

# Render a real PDF with the installed binary so a base image the binary
# cannot run on fails the deploy instead of the first document a customer
# generates. HOME points at BUILD_DIR so fontconfig sees the fonts installed
# above, matching the runtime layout.
echo "-----> Verifying wkhtmltopdf runs on this stack"
LD_LIBRARY_PATH="$LIB_PATH:${LD_LIBRARY_PATH:-}" "$BIN_PATH/wkhtmltopdf" --version
echo '<!DOCTYPE html><html><body><h1>wkhtmltopdf build smoke test</h1></body></html>' > "$TMP_PATH/smoke.html"
LD_LIBRARY_PATH="$LIB_PATH:${LD_LIBRARY_PATH:-}" HOME="$BUILD_DIR" \
  "$BIN_PATH/wkhtmltopdf" --quiet "$TMP_PATH/smoke.html" "$TMP_PATH/smoke.pdf"
if [ "$(head -c 4 "$TMP_PATH/smoke.pdf")" != "%PDF" ]; then
  echo " !     wkhtmltopdf did not produce a valid PDF on this stack" >&2
  exit 1
fi
rm -f "$TMP_PATH/smoke.html" "$TMP_PATH/smoke.pdf"
